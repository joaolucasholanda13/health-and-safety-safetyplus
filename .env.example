# Safety Plus - configuração de produção (VPS)
DOMAIN=safetyplus.tech
APP_TIMEZONE=America/Sao_Paulo
SECURE_COOKIES=true

# Gere valores fortes antes de colocar em produção.
APP_SECRET=ALTERE_PARA_UMA_CHAVE_FORTE
ADMIN_USER=admin
ADMIN_PASSWORD=ALTERE_A_SENHA_INICIAL
ADMIN_NAME=Super Administrador

POSTGRES_DB=safetyplus
POSTGRES_USER=safetyplus
POSTGRES_PASSWORD=ALTERE_A_SENHA_DO_BANCO
DATABASE_URL=postgresql+psycopg://safetyplus:ALTERE_A_SENHA_DO_BANCO@db:5432/safetyplus

# Persistência dentro do volume Docker
STORAGE_DIR=/app/storage

# Web Push / notificações no celular
# A chave privada VAPID é criada automaticamente no STORAGE_DIR e fica persistente.
VAPID_SUBJECT=https://safetyplus.tech
